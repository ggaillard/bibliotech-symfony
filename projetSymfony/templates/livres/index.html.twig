{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block fil_ariane %}
    <li class="breadcrumb-item active" aria-current="page">Catalogue</li>
{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
        <div>
            <h1 class="fw-bold mb-1">Catalogue</h1>
            <p class="text-muted mb-0">
                {{ stats.totalLivres }} livres · {{ stats.livresDisponibles }} disponibles ·
                {{ stats.totalCategories }} catégories
            </p>
        </div>
        <a href="{{ path('livres.search') }}" class="btn btn-outline-primary">
            <i class="fas fa-search"></i> Rechercher
        </a>
    </div>

    <div class="row">
        {% for livre in livres %}
            <div class="col-md-6 col-lg-4 mb-4">{{ include('livres/_carte.html.twig', {livre: livre}) }}</div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center">Aucun livre pour le moment.</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
