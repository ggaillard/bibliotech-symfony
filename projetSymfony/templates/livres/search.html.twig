{% extends 'base.html.twig' %}

{% block title %}Recherche{% endblock %}

{% block fil_ariane %}
    <li class="breadcrumb-item"><a href="{{ path('livres.index') }}">Catalogue</a></li>
    <li class="breadcrumb-item active" aria-current="page">Recherche</li>
{% endblock %}

{% block body %}
<div class="container">
    <div class="card mb-4">
        <div class="card-body">
            <h1 class="h3"><i class="fas fa-search"></i> Rechercher un livre</h1>
            <form action="{{ path('livres.search') }}" method="GET" class="mt-3">
                <div class="input-group">
                    <input type="text" name="q" class="form-control form-control-lg" aria-label="Titre ou auteur"
                           placeholder="Titre ou auteur…" value="{{ query }}">
                    <button class="btn btn-primary" type="submit">Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    {% if query != '' %}
        <h2 class="h4 mb-3">
            Résultats pour « {{ query }} »
            <span class="badge bg-secondary">{{ total }}</span>
        </h2>
    {% endif %}

    <div class="row">
        {% for livre in livres %}
            <div class="col-md-6 col-lg-4 mb-4">{{ include('livres/_carte.html.twig', {livre: livre}) }}</div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-warning">Aucun livre ne correspond à « {{ query }} ».</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
