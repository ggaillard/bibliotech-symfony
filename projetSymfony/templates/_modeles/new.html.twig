{# Modèle de démarrage pour une vue NEW (formulaire d'ajout).
   Le contrôleur doit transmettre le formulaire : $this->render('…', ['form' => $form]) #}
{% extends 'base.html.twig' %}

{% block title %}Ajouter une ressource{% endblock %}

{% block body %}
<div class="container">
    <h1 class="mb-4">Ajouter une ressource</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_errors(form) }} {# les erreurs du formulaire entier (jeton CSRF invalide…) #}
                {# TODO : un form_row par champ, dans l'ordre voulu, par exemple : #}
                {# {{ form_row(form.titre) }} #}

                {{ form_rest(form) }} {# les champs oubliés et le jeton CSRF caché #}

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    {# TODO : le lien « Annuler » vers la liste #}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
