{
  "name": "📚 BiblioTech — Symfony · MySQL",

  // Trois conteneurs décrits dans docker-compose.yml ; VS Code s'attache à « app »
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "app",
  "workspaceFolder": "/workspace",

  // Installe les dépendances, crée la base et les données de démo.
  // Le script peut être relancé sans risque (idempotent).
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "📚 BiblioTech", "onAutoForward": "notify" },
    "8080": { "label": "🗄️ phpMyAdmin", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "mblode.twig-language-2",
        "redhat.vscode-yaml",
        "xdebug.php-debug",
        "MehediDracula.php-namespace-resolver",
        "github.vscode-github-actions",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/local/bin/php",
        "editor.formatOnSave": false,
        "files.exclude": { "**/vendor": true, "**/var/cache": true },
        "terminal.integrated.cwd": "/workspace/projetSymfony",
        "emmet.includeLanguages": { "twig": "html" }
      }
    }
  }
}
